import matplotlib.pyplot as plt
import math
xi=-20
xf=0.1
n=10001
h=(xf-xi)/(n-1)
xx=[]
yy=[]
for i in range(n):
    x=xi+i*h
    y=(math.sin(x))/x
    xx.append(x)
    yy.append(y)
xi1=0.1
xf1=20
h1=(xf1-xi1)/(n-1)
xx1=[]
yy1=[]
for i in range(n):
    x1=xi1+i*h1
    y1=(math.sin(x1))/x1
    xx1.append(x1)
    yy1.append(y1)
plt.plot(xx,yy,'-r')
plt.plot(xx1,yy1,'-r')
plt.title('graph of sin(x)/x')
plt.xlabel('x',fontsize=16)
plt.ylabel('y=sin(x)/x',fontsize=16)
plt.legend()
plt.grid()
plt.show()